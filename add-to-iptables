*filter
:INPUT DROP [0:0]
:FORWARD DROP [0:0]
:OUTPUT ACCEPT [0:0]

#NEW sans SYN
-A INPUT -p tcp ! --syn -m state --state NEW -j DROP
#Bloquer les paquets qui contiennent simultanément ACK+RST+SYN+FIN
-A INPUT -p tcp --tcp-flags ALL ACK,RST,SYN,FIN -j DROP
# Les paquets TCP ne peuvent pas comprendre SYN et FIN
-A INPUT -p tcp --tcp-flags SYN,FIN SYN,FIN -j DROP
#Il s'agit de paquets mal formés
-A INPUT -p tcp --tcp-flags SYN,RST SYN,RST -j DROP
#Incoming fragments
-A INPUT -f -j DROP
#NULL Scan Packets
-A INPUT -p tcp --tcp-flags ALL NONE -j DROP
#XMAS Scan Packets
-A INPUT -p tcp --tcp-flags ALL ALL -j DROP
#FIN scan Packets 
-A INPUT -p tcp --tcp-flags ALL FIN -j DROP
#Invalid Packets /Paquets atypiques
#-A INPUT -m conntrack --cstate INVALID -j DROP
-A INPUT -m state --state INVALID -j DROP
-A OUTPUT -m state --state INVALID -j DROP
-A FORWARD -m state --state INVALID -j DROP

